# Guardian Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Provider API Key (Required for cloud providers)
# Get your key from: OpenAI, Anthropic, Google AI, or other providers
GUARDIAN_API_KEY=your_api_key_here

# Tavily API Keys for Web Search (comma-separated for rotation)
# Get your key from: https://tavily.com
TAVILY_API_KEYS=your_tavily_key_here

# GitHub OAuth App Credentials
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id

# IMPORTANT: Never commit GITHUB_CLIENT_SECRET to git!
# Store it securely in your system keyring or use GitHub's device flow only
# If you must use client_secret, set it via: export GITHUB_CLIENT_SECRET=xxx

# --- Optional Guardian Audit Resilience Tuning ---
# Increase per-provider timeout when large prompts/files are analyzed.
# Valid range: 5..600 seconds
# GUARDIAN_TIMEOUT_OPENAI=120

# Reduce batch pressure for cloud calls.
# GUARDIAN_MAX_BATCH_SIZE=2
# GUARDIAN_MAX_CONTENT_CHARS=4000
# GUARDIAN_MAX_CONTENT_LINES=180
# GUARDIAN_MAX_BATCH_PROMPT_TOKENS=3500

# Retries for transient network/provider send failures (timeouts, reset, etc.).
# GUARDIAN_SEND_FAILURE_RETRIES=2
# GUARDIAN_SEND_FAILURE_BACKOFF_SECS=2
