{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Guardian main window",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "updater:default",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-download-write",
    "fs:allow-download-write-recursive",
    "fs:allow-download-read",
    {
      "identifier": "fs:allow-read",
      "allow": [
        {
          "path": "$APP_DATA/**"
        },
        {
          "path": "$DOWNLOAD/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "$APP_DATA/**"
        },
        {
          "path": "$DOWNLOAD/**"
        }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-remove"
  ]
}
